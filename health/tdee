<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TDEE Calculator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{ --sub:#5C6C7B; --black:#111111; --line:#E3E7EA; --bg-card:#F7F8F9; }
  *{box-sizing:border-box;}
  body{ font-family:'Open Sans', sans-serif; color:var(--black); background:#ffffff; margin:0; padding:32px 16px 64px; }
  .app{ max-width:820px; margin:0 auto; }
  h1{ font-size:26px; font-weight:700; color:var(--black); margin:0 0 4px; }
  .tagline{ color:var(--sub); font-size:14px; margin:0 0 28px; }
  .panel{ display:block; }
  h2{ font-size:20px; font-weight:700; color:var(--black); margin:0 0 4px; }
  .panel-desc{ color:var(--sub); font-size:13.5px; margin:0 0 24px; line-height:1.5; }
  .field{ margin-bottom:18px; }
  label{ font-size:14px; font-weight:600; color:var(--black); }
  input[type=number], select{ width:100%; font-family:inherit; font-size:14px; font-weight:600; color:var(--sub); padding:9px 10px; border:1px solid var(--line); border-radius:6px; background:#fff; }
  input[type=number]:focus, select:focus{ outline:2px solid var(--sub); outline-offset:1px; }
  .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .grid3{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; }
  @media(max-width:560px){ .grid2, .grid3{ grid-template-columns:1fr; } }
  .results{ background:var(--bg-card); border-radius:10px; padding:20px; margin-top:8px; }
  .result-row{ display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--line); }
  .result-row:last-child{ border-bottom:none; }
  .result-label{ font-size:14px; color:var(--black); font-weight:600; }
  .result-value{ font-size:16px; font-weight:700; color:var(--sub); }
  .result-value.big{ font-size:22px; }
  .note{ font-size:12px; color:var(--sub); margin-top:14px; line-height:1.5; }
</style>
</head>
<body>
<div class="app">
  <h1>Wagner Wealth and Health</h1>
  <p class="tagline">Financial and fitness calculators</p>
  <section id="tdee" class="panel">
    <h2>TDEE Calculator</h2>
    <p class="panel-desc">Estimate your Total Daily Energy Expenditure using the Mifflin-St Jeor equation.</p>
    <div class="grid3">
      <div class="field">
        <label>Sex</label>
        <select id="td_sex">
          <option value="m">Male</option>
          <option value="f">Female</option>
        </select>
      </div>
      <div class="field">
        <label>Age</label>
        <input type="number" id="td_age" value="29" min="14" max="90">
      </div>
      <div class="field">
        <label>Weight (lb)</label>
        <input type="number" id="td_weight" value="180" min="60" max="500">
      </div>
    </div>
    <div class="grid2">
      <div class="field">
        <label>Height (ft)</label>
        <input type="number" id="td_height_ft" value="5" min="3" max="7">
      </div>
      <div class="field">
        <label>Height (in)</label>
        <input type="number" id="td_height_in" value="10" min="0" max="11">
      </div>
    </div>
    <div class="field">
      <label>Activity level</label>
      <select id="td_activity">
        <option value="1.2">Sedentary — little or no exercise</option>
        <option value="1.375">Lightly active — light exercise 1–3 days/wk</option>
        <option value="1.55" selected>Moderately active — moderate exercise 3–5 days/wk</option>
        <option value="1.725">Very active — hard exercise 6–7 days/wk</option>
        <option value="1.9">Extremely active — physical job or 2x/day training</option>
      </select>
    </div>
    <div class="results">
      <div class="result-row">
        <span class="result-label">BMR (calories at rest)</span>
        <span class="result-value" id="td_bmr">0</span>
      </div>
      <div class="result-row">
        <span class="result-label">TDEE (maintenance calories)</span>
        <span class="result-value big" id="td_tdee">0</span>
      </div>
      <div class="result-row">
        <span class="result-label">Fat loss target (−500 cal)</span>
        <span class="result-value" id="td_cut">0</span>
      </div>
      <div class="result-row">
        <span class="result-label">Muscle gain target (+300 cal)</span>
        <span class="result-value" id="td_bulk">0</span>
      </div>
      <div class="result-row">
        <span class="result-label">Suggested daily protein</span>
        <span class="result-value" id="td_protein">0 g</span>
      </div>
      <p class="note">Estimates only — individual metabolism varies. Protein suggestion is roughly 1g per pound of bodyweight, a common target for active adults.</p>
    </div>
  </section>
</div>
<script>
const tdSex=document.getElementById('td_sex'), tdAge=document.getElementById('td_age'),
      tdWeight=document.getElementById('td_weight'), tdFt=document.getElementById('td_height_ft'),
      tdIn=document.getElementById('td_height_in'), tdActivity=document.getElementById('td_activity');

function calcTDEE(){
  const sex = tdSex.value;
  const age = +tdAge.value || 0;
  const weightLb = +tdWeight.value || 0;
  const heightIn = (+tdFt.value||0)*12 + (+tdIn.value||0);
  const activity = +tdActivity.value;

  const weightKg = weightLb*0.453592;
  const heightCm = heightIn*2.54;

  let bmr = 10*weightKg + 6.25*heightCm - 5*age + (sex==='m' ? 5 : -161);
  bmr = Math.max(bmr, 0);
  const tdee = bmr*activity;

  document.getElementById('td_bmr').textContent = Math.round(bmr).toLocaleString('en-US')+' cal';
  document.getElementById('td_tdee').textContent = Math.round(tdee).toLocaleString('en-US')+' cal';
  document.getElementById('td_cut').textContent = Math.round(tdee-500).toLocaleString('en-US')+' cal';
  document.getElementById('td_bulk').textContent = Math.round(tdee+300).toLocaleString('en-US')+' cal';
  document.getElementById('td_protein').textContent = Math.round(weightLb*1.0)+' g';
}
[tdSex,tdAge,tdWeight,tdFt,tdIn,tdActivity].forEach(el=>el.addEventListener('input', calcTDEE));
calcTDEE();
</script>
</body>
</html>
