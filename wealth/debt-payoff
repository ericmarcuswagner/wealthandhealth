<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Debt Payoff Calculator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{ --sub:#5C6C7B; --black:#111111; --line:#E3E7EA; --bg-card:#F7F8F9; }
  *{box-sizing:border-box;}
  body{ font-family:'Open Sans', sans-serif; color:var(--black); background:#ffffff; margin:0; padding:32px 16px 64px; }
  .app{ max-width:820px; margin:0 auto; }
  h1{ font-size:26px; font-weight:700; color:var(--black); margin:0 0 4px; }
  .tagline{ color:var(--sub); font-size:14px; margin:0 0 28px; }
  .panel{ display:block; }
  h2{ font-size:20px; font-weight:700; color:var(--black); margin:0 0 4px; }
  .panel-desc{ color:var(--sub); font-size:13.5px; margin:0 0 24px; line-height:1.5; }
  .field{ margin-bottom:18px; }
  label{ font-size:14px; font-weight:600; color:var(--black); }
  input[type=number], input[type=text], select{ width:100%; font-family:inherit; font-size:14px; font-weight:600; color:var(--sub); padding:9px 10px; border:1px solid var(--line); border-radius:6px; background:#fff; }
  input[type=number]:focus, input[type=text]:focus, select:focus{ outline:2px solid var(--sub); outline-offset:1px; }
  .results{ background:var(--bg-card); border-radius:10px; padding:20px; margin-top:8px; }
  .result-row{ display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--line); }
  .result-row:last-child{ border-bottom:none; }
  .result-label{ font-size:14px; color:var(--black); font-weight:600; }
  .result-value{ font-size:16px; font-weight:700; color:var(--sub); }
  .result-value.big{ font-size:22px; }
  .note{ font-size:12px; color:var(--sub); margin-top:14px; line-height:1.5; }
  .btn{ font-family:inherit; font-size:13px; font-weight:700; color:#fff; background:var(--sub); border:none; border-radius:6px; padding:9px 16px; cursor:pointer; }
  .btn.secondary{ background:#fff; color:var(--sub); border:1px solid var(--sub); }
  .btn-row{ display:flex; gap:8px; margin:4px 0 18px; }
  .debt-table{ width:100%; border-collapse:collapse; }
  .debt-table th{ font-size:11px; text-transform:uppercase; letter-spacing:.03em; color:var(--sub); text-align:left; padding-bottom:6px; font-weight:700; }
  .debt-table td{ padding:6px 6px 6px 0; }
  .debt-table input{ padding:7px 8px; font-size:13px; }
  .remove-btn{ background:none; border:none; color:var(--sub); font-size:18px; cursor:pointer; line-height:1; padding:4px 8px; }
  .remove-btn:hover{ color:#c0392b; }
</style>
</head>
<body>
<div class="app">
  <h1>Wagner Wealth and Health</h1>
  <p class="tagline">Financial and fitness calculators</p>
  <section id="debt" class="panel">
    <h2>Debt Payoff Calculator</h2>
    <p class="panel-desc">Compare the avalanche (highest interest first) and snowball (smallest balance first) payoff strategies.</p>
    <table class="debt-table" id="debt_table">
      <thead>
        <tr><th>Name</th><th>Balance ($)</th><th>APR (%)</th><th>Min payment ($)</th><th></th></tr>
      </thead>
      <tbody id="debt_rows"></tbody>
    </table>
    <div class="btn-row">
      <button class="btn secondary" id="debt_add">+ Add debt</button>
    </div>
    <div class="field">
      <label>Extra monthly payment toward debt ($)</label>
      <input type="number" id="debt_extra" value="200" min="0" step="25">
    </div>
    <div class="field">
      <label>Strategy</label>
      <select id="debt_method">
        <option value="avalanche">Avalanche — highest APR first</option>
        <option value="snowball">Snowball — smallest balance first</option>
      </select>
    </div>
    <div class="results">
      <div class="result-row">
        <span class="result-label">Debt-free in</span>
        <span class="result-value big" id="debt_months">—</span>
      </div>
      <div class="result-row">
        <span class="result-label">Total interest paid</span>
        <span class="result-value" id="debt_interest">—</span>
      </div>
      <div class="result-row">
        <span class="result-label">Projected debt-free date</span>
        <span class="result-value" id="debt_date">—</span>
      </div>
      <p class="note">Simulation assumes payments are made consistently every month and APRs stay fixed. This is an estimate, not financial advice.</p>
    </div>
  </section>
</div>
<script>
const fmt$ = n => '$' + Math.round(n).toLocaleString('en-US');

let debtIdCounter = 0;
function addDebtRow(name, balance, apr, min){
  const id = 'd'+(debtIdCounter++);
  const tr = document.createElement('tr');
  tr.dataset.id = id;
  tr.innerHTML = `
    <td><input type="text" class="d-name" value="${name}"></td>
    <td><input type="number" class="d-balance" value="${balance}" min="0" step="100"></td>
    <td><input type="number" class="d-apr" value="${apr}" min="0" step="0.1"></td>
    <td><input type="number" class="d-min" value="${min}" min="0" step="5"></td>
    <td><button class="remove-btn" title="Remove">×</button></td>
  `;
  tr.querySelector('.remove-btn').addEventListener('click', ()=>{ tr.remove(); calcDebt(); });
  tr.querySelectorAll('input').forEach(inp=>inp.addEventListener('input', calcDebt));
  document.getElementById('debt_rows').appendChild(tr);
}
document.getElementById('debt_add').addEventListener('click', ()=>{ addDebtRow('New debt', 5000, 15, 100); calcDebt(); });

function readDebts(){
  const rows = document.querySelectorAll('#debt_rows tr');
  const debts = [];
  rows.forEach(r=>{
    const balance = +r.querySelector('.d-balance').value || 0;
    const apr = +r.querySelector('.d-apr').value || 0;
    const min = +r.querySelector('.d-min').value || 0;
    if(balance>0) debts.push({balance, apr, min});
  });
  return debts;
}

function simulateDebts(debts, extra, method){
  let d = debts.map(x=>({...x}));
  if(method==='avalanche') d.sort((a,b)=>b.apr-a.apr);
  else d.sort((a,b)=>a.balance-b.balance);

  let month=0, totalInterest=0;
  while(d.some(x=>x.balance>0.01) && month<1200){
    month++;
    d.forEach(x=>{
      if(x.balance>0.01){
        const int = x.balance*(x.apr/100/12);
        x.balance += int;
        totalInterest += int;
      }
    });
    const freed = d.filter(x=>x.balance<=0.01).reduce((s,x)=>s+x.min,0);
    const targetIdx = d.findIndex(x=>x.balance>0.01);
    d.forEach((x,i)=>{
      if(x.balance<=0.01) return;
      let pay = x.min;
      if(i===targetIdx) pay += extra + freed;
      pay = Math.min(pay, x.balance);
      x.balance -= pay;
    });
  }
  return {months: month, totalInterest};
}

function calcDebt(){
  const debts = readDebts();
  const extra = +document.getElementById('debt_extra').value || 0;
  const method = document.getElementById('debt_method').value;

  if(debts.length===0){
    document.getElementById('debt_months').textContent = '—';
    document.getElementById('debt_interest').textContent = '—';
    document.getElementById('debt_date').textContent = '—';
    return;
  }

  const result = simulateDebts(debts, extra, method);
  const years = Math.floor(result.months/12);
  const rem = result.months%12;
  let durationStr = '';
  if(years>0) durationStr += years+' yr ';
  durationStr += rem+' mo';

  document.getElementById('debt_months').textContent = durationStr;
  document.getElementById('debt_interest').textContent = fmt$(result.totalInterest);

  const now = new Date();
  now.setMonth(now.getMonth()+result.months);
  document.getElementById('debt_date').textContent = now.toLocaleDateString('en-US', {month:'long', year:'numeric'});
}
document.getElementById('debt_extra').addEventListener('input', calcDebt);
document.getElementById('debt_method').addEventListener('change', calcDebt);

addDebtRow('Credit card', 6500, 22, 150);
addDebtRow('Auto loan', 14000, 6.5, 320);
addDebtRow('Student loan', 22000, 5, 250);
calcDebt();
</script>
</body>
</html>
