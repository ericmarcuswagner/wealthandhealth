<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Investment Growth Calculator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{ --sub:#5C6C7B; --black:#111111; --line:#E3E7EA; --bg-card:#F7F8F9; }
  *{box-sizing:border-box;}
  body{ font-family:'Open Sans', sans-serif; color:var(--black); background:#ffffff; margin:0; padding:32px 16px 64px; }
  .app{ max-width:820px; margin:0 auto; }
  h1{ font-size:26px; font-weight:700; color:var(--black); margin:0 0 4px; }
  .tagline{ color:var(--sub); font-size:14px; margin:0 0 28px; }
  .panel{ display:block; }
  h2{ font-size:20px; font-weight:700; color:var(--black); margin:0 0 4px; }
  .panel-desc{ color:var(--sub); font-size:13.5px; margin:0 0 24px; line-height:1.5; }
  .field{ margin-bottom:18px; }
  .field-row{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom:6px; }
  label{ font-size:14px; font-weight:600; color:var(--black); }
  .value-badge{ font-size:14px; font-weight:700; color:var(--sub); min-width:70px; text-align:right; }
  input[type=range]{ width:100%; accent-color:var(--sub); height:4px; cursor:pointer; }
  input[type=number], input[type=text], select{ width:100%; font-family:inherit; font-size:14px; font-weight:600; color:var(--sub); padding:9px 10px; border:1px solid var(--line); border-radius:6px; background:#fff; }
  input[type=number]:focus, input[type=text]:focus, select:focus{ outline:2px solid var(--sub); outline-offset:1px; }
  .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .grid3{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; }
  @media(max-width:560px){ .grid2, .grid3{ grid-template-columns:1fr; } }
  .results{ background:var(--bg-card); border-radius:10px; padding:20px; margin-top:8px; }
  .result-row{ display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--line); }
  .result-row:last-child{ border-bottom:none; }
  .result-label{ font-size:14px; color:var(--black); font-weight:600; }
  .result-value{ font-size:16px; font-weight:700; color:var(--sub); }
  .result-value.big{ font-size:22px; }
  .note{ font-size:12px; color:var(--sub); margin-top:14px; line-height:1.5; }
  .chart-svg{ width:100%; height:auto; }
</style>
</head>
<body>
<div class="app">
  <h1>Wagner Wealth and Health</h1>
  <p class="tagline">Financial and fitness calculators</p>
  <section id="growth" class="panel">
    <h2>Investment Growth Calculator</h2>
    <p class="panel-desc">Project how a portfolio grows over time with compounding and ongoing contributions.</p>
    <div class="grid2">
      <div class="field">
        <label>Starting amount ($)</label>
        <input type="number" id="gr_start" value="10000" min="0" step="500">
      </div>
      <div class="field">
        <label>Additional monthly contribution ($)</label>
        <input type="number" id="gr_contrib" value="500" min="0" step="50">
      </div>
    </div>
    <div class="field">
      <div class="field-row"><label>Timeline (years)</label><span class="value-badge" id="gr_years_val">20</span></div>
      <input type="range" id="gr_years" min="1" max="50" value="20">
    </div>
    <div class="field">
      <div class="field-row"><label>Expected annual return</label><span class="value-badge" id="gr_return_val">7%</span></div>
      <input type="range" id="gr_return" min="0" max="15" step="0.5" value="7">
    </div>
    <div class="results">
      <div class="result-row">
        <span class="result-label">Future value</span>
        <span class="result-value big" id="gr_fv">$0</span>
      </div>
      <div class="result-row">
        <span class="result-label">Total contributed</span>
        <span class="result-value" id="gr_contributed">$0</span>
      </div>
      <div class="result-row">
        <span class="result-label">Total growth</span>
        <span class="result-value" id="gr_growth">$0</span>
      </div>
      <svg class="chart-svg" id="gr_chart" viewBox="0 0 700 220" preserveAspectRatio="none"></svg>
      <p class="note">Assumes a constant average annual return compounded monthly. Actual investment returns fluctuate.</p>
    </div>
  </section>
</div>
<script>
const fmt$ = n => '$' + Math.round(n).toLocaleString('en-US');

const grStart=document.getElementById('gr_start'), grContrib=document.getElementById('gr_contrib'),
      grYears=document.getElementById('gr_years'), grReturn=document.getElementById('gr_return');

function calcGrowth(){
  document.getElementById('gr_years_val').textContent = grYears.value;
  document.getElementById('gr_return_val').textContent = (+grReturn.value).toFixed(1)+'%';

  const start = +grStart.value || 0;
  const contrib = +grContrib.value || 0;
  const years = +grYears.value;
  const annualReturn = +grReturn.value/100;
  const monthlyRate = annualReturn/12;

  let balance = start;
  const yearlyBalances = [start];
  for(let m=1; m<=years*12; m++){
    balance = balance*(1+monthlyRate) + contrib;
    if(m%12===0) yearlyBalances.push(balance);
  }
  const contributed = start + contrib*years*12;
  const growth = balance - contributed;

  document.getElementById('gr_fv').textContent = fmt$(balance);
  document.getElementById('gr_contributed').textContent = fmt$(contributed);
  document.getElementById('gr_growth').textContent = fmt$(growth);

  drawChart(yearlyBalances);
}

function drawChart(values){
  const svg = document.getElementById('gr_chart');
  const w=700, h=220, pad=30;
  const max = Math.max(...values, 1);
  const stepX = (w-pad*2)/(values.length-1 || 1);
  let points = values.map((v,i)=> {
    const x = pad + i*stepX;
    const y = h-pad - (v/max)*(h-pad*2);
    return [x,y];
  });
  let path = 'M '+points.map(p=>p.join(',')).join(' L ');
  let areaPath = path + ` L ${points[points.length-1][0]},${h-pad} L ${points[0][0]},${h-pad} Z`;

  svg.innerHTML = `
    <path d="${areaPath}" fill="#5C6C7B" opacity="0.12"></path>
    <path d="${path}" fill="none" stroke="#5C6C7B" stroke-width="2.5"></path>
    <line x1="${pad}" y1="${h-pad}" x2="${w-pad}" y2="${h-pad}" stroke="#E3E7EA" stroke-width="1"></line>
  `;
}
[grStart,grContrib,grYears,grReturn].forEach(el=>el.addEventListener('input', calcGrowth));
calcGrowth();
</script>
</body>
</html>
