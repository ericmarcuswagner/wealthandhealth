<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Retirement Number Calculator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{ --sub:#5C6C7B; --black:#111111; --line:#E3E7EA; --bg-card:#F7F8F9; }
  *{box-sizing:border-box;}
  body{ font-family:'Open Sans', sans-serif; color:var(--black); background:#ffffff; margin:0; padding:32px 16px 64px; }
  .app{ max-width:820px; margin:0 auto; }
  h1{ font-size:26px; font-weight:700; color:var(--black); margin:0 0 4px; }
  .tagline{ color:var(--sub); font-size:14px; margin:0 0 28px; }
  .panel{ display:block; }
  h2{ font-size:20px; font-weight:700; color:var(--black); margin:0 0 4px; }
  .panel-desc{ color:var(--sub); font-size:13.5px; margin:0 0 24px; line-height:1.5; }
  .field{ margin-bottom:18px; }
  .field-row{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom:6px; }
  label{ font-size:14px; font-weight:600; color:var(--black); }
  .value-badge{ font-size:14px; font-weight:700; color:var(--sub); min-width:70px; text-align:right; }
  input[type=range]{ width:100%; accent-color:var(--sub); height:4px; cursor:pointer; }
  input[type=number], input[type=text], select{ width:100%; font-family:inherit; font-size:14px; font-weight:600; color:var(--sub); padding:9px 10px; border:1px solid var(--line); border-radius:6px; background:#fff; }
  input[type=number]:focus, input[type=text]:focus, select:focus{ outline:2px solid var(--sub); outline-offset:1px; }
  .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .grid3{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; }
  @media(max-width:560px){ .grid2, .grid3{ grid-template-columns:1fr; } }
  .results{ background:var(--bg-card); border-radius:10px; padding:20px; margin-top:8px; }
  .result-row{ display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--line); }
  .result-row:last-child{ border-bottom:none; }
  .result-label{ font-size:14px; color:var(--black); font-weight:600; }
  .result-value{ font-size:16px; font-weight:700; color:var(--sub); }
  .result-value.big{ font-size:22px; }
  .progress-outer{ height:10px; background:#E3E7EA; border-radius:6px; overflow:hidden; margin:14px 0 4px; }
  .progress-inner{ height:100%; background:var(--sub); border-radius:6px; transition:width .2s ease; }
  .progress-caption{ font-size:12px; color:var(--sub); text-align:right; }
  .note{ font-size:12px; color:var(--sub); margin-top:14px; line-height:1.5; }
</style>
</head>
<body>
<div class="app">
  <h1>Wagner Wealth and Health</h1>
  <p class="tagline">Financial and fitness calculators</p>
  <section id="retirement" class="panel">
    <h2>Retirement Number Calculator</h2>
    <p class="panel-desc">Estimate how much you need saved to retire, and whether your current trajectory gets you there.</p>
    <div class="field">
      <div class="field-row"><label>Current age</label><span class="value-badge" id="ret_age_val">29</span></div>
      <input type="range" id="ret_age" min="18" max="70" value="29">
    </div>
    <div class="field">
      <div class="field-row"><label>Retirement age</label><span class="value-badge" id="ret_retage_val">65</span></div>
      <input type="range" id="ret_retage" min="35" max="80" value="65">
    </div>
    <div class="grid2">
      <div class="field">
        <label>Current savings ($)</label>
        <input type="number" id="ret_savings" value="50000" min="0" step="1000">
      </div>
      <div class="field">
        <label>Monthly contribution ($)</label>
        <input type="number" id="ret_contrib" value="1500" min="0" step="50">
      </div>
    </div>
    <div class="field">
      <div class="field-row"><label>Expected annual return</label><span class="value-badge" id="ret_return_val">7%</span></div>
      <input type="range" id="ret_return" min="1" max="12" step="0.5" value="7">
    </div>
    <div class="field">
      <label>Desired annual spending in retirement ($, today's dollars)</label>
      <input type="number" id="ret_expenses" value="60000" min="0" step="1000">
    </div>
    <div class="field">
      <div class="field-row"><label>Safe withdrawal rate</label><span class="value-badge" id="ret_swr_val">4%</span></div>
      <input type="range" id="ret_swr" min="2.5" max="6" step="0.25" value="4">
    </div>
    <div class="results">
      <div class="result-row">
        <span class="result-label">Retirement number needed</span>
        <span class="result-value big" id="ret_number">$0</span>
      </div>
      <div class="result-row">
        <span class="result-label">Projected savings at retirement age</span>
        <span class="result-value" id="ret_projected">$0</span>
      </div>
      <div class="result-row">
        <span class="result-label">Surplus / shortfall</span>
        <span class="result-value" id="ret_gap">$0</span>
      </div>
      <div class="progress-outer"><div class="progress-inner" id="ret_progress_bar" style="width:0%"></div></div>
      <div class="progress-caption" id="ret_progress_caption">0% of goal</div>
      <p class="note">Assumes fixed monthly contributions and a constant average annual return; actual markets vary year to year. This is an estimate, not financial advice.</p>
    </div>
  </section>
</div>
<script>
const fmt$ = n => '$' + Math.round(n).toLocaleString('en-US');
const fmtSigned$ = n => (n>=0?'+':'−') + '$' + Math.round(Math.abs(n)).toLocaleString('en-US');

const retAge=document.getElementById('ret_age'), retRetage=document.getElementById('ret_retage'),
      retSavings=document.getElementById('ret_savings'), retContrib=document.getElementById('ret_contrib'),
      retReturn=document.getElementById('ret_return'), retExpenses=document.getElementById('ret_expenses'),
      retSwr=document.getElementById('ret_swr');

function calcRetirement(){
  const age = +retAge.value, retage = Math.max(+retRetage.value, age+1);
  retRetage.min = age+1;
  document.getElementById('ret_age_val').textContent = age;
  document.getElementById('ret_retage_val').textContent = retage;
  document.getElementById('ret_return_val').textContent = (+retReturn.value).toFixed(1)+'%';
  document.getElementById('ret_swr_val').textContent = (+retSwr.value).toFixed(2)+'%';

  const savings = +retSavings.value || 0;
  const contrib = +retContrib.value || 0;
  const annualReturn = +retReturn.value/100;
  const monthlyRate = annualReturn/12;
  const months = (retage-age)*12;
  const expenses = +retExpenses.value || 0;
  const swr = +retSwr.value/100;

  const retirementNumber = swr>0 ? expenses/swr : 0;

  let fv;
  if(monthlyRate>0){
    fv = savings*Math.pow(1+monthlyRate, months) + contrib*((Math.pow(1+monthlyRate, months)-1)/monthlyRate);
  } else {
    fv = savings + contrib*months;
  }

  const gap = fv - retirementNumber;
  const pct = retirementNumber>0 ? Math.min(100, (fv/retirementNumber)*100) : 0;

  document.getElementById('ret_number').textContent = fmt$(retirementNumber);
  document.getElementById('ret_projected').textContent = fmt$(fv);
  document.getElementById('ret_gap').textContent = fmtSigned$(gap);
  document.getElementById('ret_progress_bar').style.width = pct+'%';
  document.getElementById('ret_progress_caption').textContent = pct.toFixed(0)+'% of goal at retirement age';
}
[retAge,retRetage,retSavings,retContrib,retReturn,retExpenses,retSwr].forEach(el=>el.addEventListener('input', calcRetirement));
calcRetirement();
</script>
</body>
</html>
