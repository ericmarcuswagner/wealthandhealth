  function render() {
    var risk = +riskInput.value;
    var age = parseInt(currentAgeValueEl.value, 10) || 18;
    var retireAge = parseInt(retireAgeValueEl.value, 10) || 45;
    var funMoneyPct = +funMoneyInput.value;
    var equityComplexityLevel = +equityComplexityInput.value;
    var fiComplexityLevel = +fiComplexityInput.value;
    var equityComplexity = ['low', 'medium', 'high'][equityComplexityLevel - 1];
    var fiComplexity = ['low', 'medium', 'high'][fiComplexityLevel - 1];
    var balance = parseBalance(balanceInput.value);
    // Effectively retired if the checkbox is on, OR current age has already reached retirement age --
    // the fund lineup should reflect reality even if someone hasn't (or forgot to) check the box.
    var isRetired = retiredToggle.checked || age >= retireAge;
    var base = computeBase(risk, age, retireAge, funMoneyPct, isRetired);
    var equityModel = getEquityModel(equityComplexity, base.equity, isRetired);
    var fiModel = getFixedIncomeModel(fiComplexity, base.bonds, base.composite);
    
    var riskLabel = RISK_LABELS[risk - 1];
    riskValueEl.textContent = riskLabel;
    riskInput.setAttribute('aria-valuetext', riskLabel);
    updateTicks(riskTicks, risk);
    setFill(riskInput);
    
    setFill(currentAgeInput);
    setFill(retireAgeInput);
    
    funMoneyValueEl.textContent = funMoneyPct + '%';
    setFill(funMoneyInput);
    var portfolioComplexityLevel = +portfolioComplexityInput.value;
    var portfolioComplexityLabel = COMPLEXITY_LABELS[portfolioComplexityLevel - 1];
    portfolioComplexityValueEl.textContent = portfolioComplexityLabel;
    portfolioComplexityInput.setAttribute('aria-valuetext', portfolioComplexityLabel);
    updateTicks(portfolioComplexityTicks, portfolioComplexityLevel);
    setFill(portfolioComplexityInput);
    var equityComplexityLabel = COMPLEXITY_LABELS[equityComplexityLevel - 1];
    equityComplexityValueEl.textContent = equityComplexityLabel;
    equityComplexityInput.setAttribute('aria-valuetext', equityComplexityLabel);
    updateTicks(equityComplexityTicks, equityComplexityLevel);
    setFill(equityComplexityInput);
    var fiComplexityLabel = COMPLEXITY_LABELS[fiComplexityLevel - 1];
    fiComplexityValueEl.textContent = fiComplexityLabel;
    fiComplexityInput.setAttribute('aria-valuetext', fiComplexityLabel);
    updateTicks(fiComplexityTicks, fiComplexityLevel);
    setFill(fiComplexityInput);
    
    readoutEl.innerHTML = 'Aggressiveness Score: <span class="readout__figure">' + Math.round(base.composite * 100) + '%</span>';
    
    var overviewCategories;
    if (expandedViewToggle.checked) {
      overviewCategories = equityModel.displayCategories.concat(fiModel.displayCategories);
      if (base.funMoney > 0) {
        overviewCategories.push({ key: 'fun', label: 'Satellite Allocation', color: 'plum', pct: base.funMoney });
      }
    } else {
      overviewCategories = [
        { key: 'stocks', label: 'Stocks', color: 'gold', pct: base.equity },
        { key: 'bonds', label: 'Bonds', color: 'steel', pct: base.bonds }
      ];
      if (base.funMoney > 0) {
        overviewCategories.push({ key: 'fun', label: 'Satellite Allocation', color: 'plum', pct: base.funMoney });
      }
    }
    
    renderOverview(overviewCategories, balance);
    
    var eqTotal = renderTable(equityModel, tableEquityEl, balance);
    var fiTotal = renderTable(fiModel, tableFiEl, balance);
    
    equityTotalEl.textContent = fmt(eqTotal, 1) + ' \u00B7 ' + fmtMoney(balance * eqTotal / 100);
    fiTotalEl.textContent = fmt(fiTotal, 1) + ' \u00B7 ' + fmtMoney(balance * fiTotal / 100);
    
    if (base.funMoney > 0) {
      funMoneySection.style.display = '';
      funMoneyDisplayEl.textContent = fmt(base.funMoney, 1) + ' \u00B7 ' + fmtMoney(balance * base.funMoney / 100);
    } else {
      funMoneySection.style.display = 'none';
    }
    lastRender = { equityModel: equityModel, fiModel: fiModel, base: base, balance: balance };
    syncURL();
  }
  
  [riskInput, funMoneyInput, equityComplexityInput, fiComplexityInput, balanceInput].forEach(function (el) {
    el.addEventListener('input', render);
  });
  
  expandedViewToggle.addEventListener('change', render);
  
  wireAgeInput(currentAgeInput, currentAgeValueEl, 18, 80);
  wireAgeInput(retireAgeInput, retireAgeValueEl, 45, 85);
  
  portfolioComplexityInput.addEventListener('input', function () {
    if (!customizeToggle.checked) {
      equityComplexityInput.value = portfolioComplexityInput.value;
      fiComplexityInput.value = portfolioComplexityInput.value;
    }
    render();
  });
  
  customizeToggle.addEventListener('change', function () {
    if (customizeToggle.checked) {
      equityComplexityInput.value = portfolioComplexityInput.value;
      fiComplexityInput.value = portfolioComplexityInput.value;
      portfolioComplexityBlock.hidden = true;
      advancedComplexity.hidden = false;
    } else {
      equityComplexityInput.value = portfolioComplexityInput.value;
      fiComplexityInput.value = portfolioComplexityInput.value;
      portfolioComplexityBlock.hidden = false;
      advancedComplexity.hidden = true;
    }
    render();
  });
  
  retiredToggle.addEventListener('change', function () {
    ageRowEl.style.display = retiredToggle.checked ? 'none' : '';
    render();
  });
  
  balanceInput.addEventListener('blur', function () {
    var n = parseBalance(balanceInput.value);
    balanceInput.value = n ? n.toLocaleString('en-US') : '';
  });

  downloadCsvBtn.addEventListener('click', downloadCSV);
  copySummaryBtn.addEventListener('click', function () {
    copyText(buildSummaryText(), copySummaryBtn, 'Summary Copied!');
  });
  copyLinkBtn.addEventListener('click', function () {
    copyText(buildShareURL(), copyLinkBtn, 'Link Copied!');
  });

  readStateFromURL();
  render();
})();
</script>
</body>
</html>
