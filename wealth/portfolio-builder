  function buildCSV() {
    var rows = [['Section', 'Category', 'Ticker', 'Description', 'Percent', 'Amount']];
    forEachRow(function (section, category, ticker, desc, pct, amt) {
      rows.push([section, category, ticker, desc, pct.toFixed(2) + '%', fmtMoney(amt)]);
    });
    return rows.map(function (r) { return r.map(csvEscape).join(','); }).join('\n');
  }

  function downloadCSV() {
    var csv = buildCSV();
    var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'portfolio-builder-allocation.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
  }

