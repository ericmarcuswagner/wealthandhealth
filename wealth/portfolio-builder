  function clampInt(v, min, max, fallback) {
    var n = parseInt(v, 10);
    if (isNaN(n)) return fallback;
    return Math.max(min, Math.min(max, n));
  }

  function readStateFromURL() {
    var params = new URLSearchParams(window.location.search);
    if (!params.has('r') && !params.has('a')) return false;

    riskInput.value = clampInt(params.get('r'), 1, 5, +riskInput.value);
    currentAgeInput.value = clampInt(params.get('a'), +currentAgeInput.min, +currentAgeInput.max, +currentAgeInput.value);
    retireAgeInput.value = clampInt(params.get('ra'), +retireAgeInput.min, +retireAgeInput.max, +retireAgeInput.value);
    currentAgeValueEl.value = currentAgeInput.value;
    retireAgeValueEl.value = retireAgeInput.value;
    funMoneyInput.value = clampInt(params.get('f'), 0, 10, +funMoneyInput.value);
    portfolioComplexityInput.value = clampInt(params.get('pc'), 1, 3, +portfolioComplexityInput.value);
    equityComplexityInput.value = clampInt(params.get('ec'), 1, 3, +equityComplexityInput.value);
    fiComplexityInput.value = clampInt(params.get('fc'), 1, 3, +fiComplexityInput.value);
    customizeToggle.checked = params.get('sp') === '1';
    expandedViewToggle.checked = params.get('dv') === '1';
    retiredToggle.checked = params.get('ret') === '1';
    var bal = clampInt(params.get('b'), 0, 999999999, parseBalance(balanceInput.value));
    balanceInput.value = bal.toLocaleString('en-US');

    portfolioComplexityBlock.hidden = customizeToggle.checked;
    advancedComplexity.hidden = !customizeToggle.checked;
