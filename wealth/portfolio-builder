  function computeBase(risk, age, retireAge, funMoneyPct, isRetired) {
    var riskFactor = (risk - 1) / 4;
    var yearsRaw = isRetired ? 0 : (retireAge - age);
    var years = Math.max(0, yearsRaw);
    var ageFactor = isRetired ? 0 : Math.min(1, years / MAX_HORIZON_YEARS);

    var composite = 0.5 * riskFactor + 0.5 * ageFactor;

    // Max Bonds = 40%
    var rawBonds = MAX_BONDS_PCT * (1 - composite);
    var rawEquity = 100 - rawBonds;

    return {
      years: years,
      isPastTarget: yearsRaw <= 0,
      composite: composite,
      funMoney: funMoneyPct,
      bonds: rawBonds,               // Bonds are left untouched by the satellite allocation
      equity: rawEquity - funMoneyPct // Satellite allocation is deducted entirely from equities
    };
  }

  function getEquityModel(complexity, equityPct, isRetired) {
    if (complexity === 'low') {
      return {
        displayCategories: [{ key: 'equity', label: 'Market', color: 'gold', pct: equityPct }],
        tickers: [{ key: 'VT', dispCat: 'equity', label: 'Vanguard Total World Stock', pct: equityPct }]
      };
    }
    if (complexity === 'medium') {
      var vtPct = MARKET_PCT; // VT/Market remains fixed at 50% of the overall portfolio
      var restPct = equityPct - vtPct; // Satellite allocation is absorbed here (by non-market funds)
      
      // Fallback: If non-market funds (Min Vol or Factor Tilt) drop to 0% or below, 
      // consolidate the remaining equities completely into VT (market) and hide the empty categories.
      if (restPct <= 0) {
        return {
          displayCategories: [{ key: 'market', label: 'Market', color: 'gold', pct: equityPct }],
          tickers: [{ key: 'VT', dispCat: 'market', label: 'Vanguard Total World Stock', pct: equityPct }]
        };
      }
      
      if (isRetired) {
        return {
          displayCategories: [
            { key: 'market', label: 'Market', color: 'gold', pct: vtPct },
            { key: 'minvol', label: 'Min Vol', color: 'rust', pct: restPct }
          ],
          tickers: [
            { key: 'VT', dispCat: 'market', label: 'Vanguard Total World Stock', pct: vtPct },
            { key: 'ACWV', dispCat: 'minvol', label: 'Global Min Volatility', pct: restPct }
          ]
        };
      }
      return {
        displayCategories: [
          { key: 'market', label: 'Market', color: 'gold', pct: vtPct },
          { key: 'tilt', label: 'Factor Tilt', color: 'rust', pct: restPct }
        ],
        tickers: [
          { key: 'VT', dispCat: 'market', label: 'Vanguard Total World Stock', pct: vtPct },
          { key: 'AVGV', dispCat: 'tilt', label: 'Global Value', pct: restPct }
        ]
      };
    }
    
    // High Complexity
    var market = MARKET_PCT; // Market is held constant at 50%
    var factor = equityPct - market; // Non-market sleeve absorbs satellite reduction
    
    // Fallback: If non-market funds (Min Vol, SCV, Momentum) drop to 0% or below,
    // consolidate the remaining equities completely into VT (market) and hide the factor categories.
    if (factor <= 0) {
      return {
        displayCategories: [{ key: 'market', label: 'Market', color: 'gold', pct: equityPct }],
        tickers: [{ key: 'VT', dispCat: 'market', label: 'Vanguard Total World Stock', pct: equityPct }]
      };
    }
    
    if (isRetired) {
      return {
        displayCategories: [
          { key: 'market', label: 'Market', color: 'gold', pct: market },
