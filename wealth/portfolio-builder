  function getFixedIncomeModel(complexity, bondsPct, composite) {
    // Low Complexity: 100% Core (VGIT)
    if (complexity === 'low') {
      return {
        displayCategories: [{ key: 'core', label: 'Core', color: 'steel', pct: bondsPct }],
        tickers: [{ key: 'VGIT', dispCat: 'core', label: 'Intermediate Treasury', pct: bondsPct }]
      };
    }
    // Medium Complexity: Core (VGLT) & Defensive (VTIP)
    if (complexity === 'medium') {
      // ratio moves from 80/20 (conservative) to 50/50 (aggressive)
      var corePctOfBonds = 80 - (30 * composite);
      var defensivePctOfBonds = 20 + (30 * composite);

      var coreAmt = bondsPct * (corePctOfBonds / 100);
      var defensiveAmt = bondsPct * (defensivePctOfBonds / 100);
      return {
        displayCategories: [
          { key: 'core', label: 'Core', color: 'steel', pct: coreAmt },
          { key: 'defensive', label: 'Defensive', color: 'defensive', pct: defensiveAmt }
        ],
        tickers: [
          { key: 'VGLT', dispCat: 'core', label: 'Long-Term Treasury', pct: coreAmt },
          { key: 'VTIP', dispCat: 'defensive', label: 'Short-Term TIPS', pct: defensiveAmt }
        ]
      };
    }
    // High Complexity: Core (VGLT) 50%, Yield (JAAA), Defensive (VTIP)
    // Yield:Defensive ratio goes from 20:80 (conservative) to 50:50 (aggressive)
    var coreAmt = bondsPct * 0.50;

    var yieldShareOfRemaining = 20 + (30 * composite); // 20 to 50
    var defensiveShareOfRemaining = 80 - (30 * composite); // 80 to 50

    var yieldAmt = bondsPct * 0.50 * (yieldShareOfRemaining / 100);
    var defensiveAmt = bondsPct * 0.50 * (defensiveShareOfRemaining / 100);
    return {
      displayCategories: [
        { key: 'core', label: 'Core', color: 'steel', pct: coreAmt },
        { key: 'defensive', label: 'Defensive', color: 'defensive', pct: defensiveAmt },
        { key: 'yield', label: 'Yield', color: 'yield', pct: yieldAmt }
      ],
      tickers: [
        { key: 'VGLT', dispCat: 'core', label: 'Long-Term Treasury', pct: coreAmt },
        { key: 'VTIP', dispCat: 'defensive', label: 'Short-Term TIPS', pct: defensiveAmt },
        { key: 'JAAA', dispCat: 'yield', label: 'AAA CLO', pct: yieldAmt }
      ]
    };
  }
